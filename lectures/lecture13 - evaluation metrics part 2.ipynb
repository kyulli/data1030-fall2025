    "\n",
    "so no TP, FP\n",
    "\n",
    "    TP = 0\n",
    "    FP = 0\n",
    "    FN = 所有 true positives\n",
    "    TN = 所有 true negatives\n",
    "\n",
    "    TPR = TP / (TP + FN) = 0 / (0 + FN) = 0\n",
    "    FPR = FP / (FP + TN) = 0 / (0 + TN) = 0\n",
    "\n",
    "    tpr = 0\n",
    "    fpr = 0"
